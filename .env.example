# Iris — Web-Native MCP Server
# Copy to .env and fill in values

# Listen address (default: 0.0.0.0:3000)
IRIS_ADDR=0.0.0.0:3000

# API key for HTTP mode authentication
IRIS_API_KEY=

# Per-tool-call timeout in seconds
IRIS_TOOL_TIMEOUT=30

# Log level: debug, info, warn, error
IRIS_LOG_LEVEL=debug

# Browser configuration
IRIS_HEADLESS=true
IRIS_NO_SANDBOX=true
IRIS_CHROME_PATH=
# Run Chrome non-headless against a Xvfb virtual display (better bot evasion, ~100 MB extra RAM).
# Requires xvfb to be installed. Automatically sets IRIS_HEADLESS=false.
IRIS_XVFB=false

# Grounding model (vision model for screenshot-based element finding)
IRIS_GROUNDING_URL=
IRIS_GROUNDING_MODEL=
IRIS_GROUNDING_API_KEY=
IRIS_GROUNDING_TIMEOUT=60
IRIS_GROUNDING_MAX_DIM=1280
IRIS_GROUNDING_BBOX_SCALE=1000

# Verify model (separate model for verify_screen, falls back to grounding model)
IRIS_VERIFY_MODEL=

# Screenshot debug overlay directory (default: OS cache dir /iris)
IRIS_SCREENSHOT_DIR=

# Annotate click positions on screenshots (1 = on, 0 = off)
IRIS_ANNOTATE_CLICKS=1

# Point-mode click radius in pixels (expands a single point into a bounding box)
IRIS_GROUNDING_POINT_CLICK_RADIUS=15