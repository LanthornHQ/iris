# Iris — Web-Native MCP Server
# Copy to .env and fill in values

# Listen address (default: 0.0.0.0:3000)
IRIS_ADDR=0.0.0.0:3000

# API key for HTTP mode authentication
IRIS_API_KEY=

# Per-tool-call timeout in seconds
IRIS_TOOL_TIMEOUT=30

# Log level: debug, info, warn, error
IRIS_LOG_LEVEL=debug

# Browser configuration
# Set IRIS_HEADLESS=false to run Chrome against a real or virtual (Xvfb) display.
# The Docker image uses entrypoint.sh which starts Xvfb automatically.
IRIS_HEADLESS=true
IRIS_NO_SANDBOX=true
IRIS_CHROME_PATH=

# Inject opt-in Google & YouTube consent/bypass cookies (1 = on, 0 = off)
IRIS_BYPASS_GOOGLE_CONSENT=0

# Screenshot debug overlay directory (default: OS cache dir /iris)
IRIS_SCREENSHOT_DIR=

# Initial cookies to inject at startup (JSON array of cookies, e.g., [{"name":"foo","value":"bar","domain":"example.com","path":"/"}])
IRIS_INITIAL_COOKIES=

# Annotate click positions on screenshots (server-wide fallback default: 1 = on, 0 = off)
IRIS_ANNOTATE_CLICKS=0